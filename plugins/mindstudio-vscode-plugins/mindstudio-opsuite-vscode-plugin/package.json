{
  "name": "mindstudio-opsuite-vscode-plugin",
  "displayName": "MindStudio Opsuite",
  "description": "A comprehensive operations suite for MindStudio",
  "publisher": "huawei",
  "version": "1.0.81",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/plugin/src/extension.js",
  "extensionDependencies": [
    "ms-vscode-remote.remote-ssh"
  ],
  "activationEvents": [
    "onView:pluginSidebar",
    "workspaceContains:package.json",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindstudio-opssuite-vscode-plugin",
          "title": "算子一站式交付平台",
          "icon": "resources/homeIcon.svg"
        }
      ]
    },
    "views": {
      "mindstudio-opssuite-vscode-plugin":[
        {
          "id": "pluginSidebar",
          "name": "功能列表",
          "type": "webview"
        }
      ],
      "explorer": [
        {
          "id": "customSidebarView",
          "name": "操作面板",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "mindstudio-opsuite.open",
        "title": "新建算子工程"
      },
      {
        "command": "mindstudio-opsuite.buildOps",
        "title": "编译算子"
      },
      {
        "command": "mindstudio-opsuite.config",
        "title": "配置"
      },
      {
        "command": "mindstudio-opsuite.leftNaV",
        "title": "左侧菜单配置"
      },
      {
        "command": "mindstudio-opsuite.newPrototype",
        "title": "新建算子原型定义文件",
        "icon": "resources/homeIconW.svg"
      },
      {
        "command": "mindstudio-opsuite.createOps",
        "title": "新建算子原型文件",
        "icon": "resources/ops.svg"
      },
      {
        "command": "extension.jsonButtonAction",
        "title": "生成算子工程",
        "category": "JSON Tools"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mindstudio-opsuite.open",
          "group": "navigation"
        },
        {
          "command": "mindstudio-opsuite.createOps",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mindstudio-opsuite.newPrototype",
          "group": "navigation",
          "when": "view == workbench.explorer.fileView",
          "icon": {
            "light": "resources/homeIconW.svg",
            "dark": "resources/homeIconW.svg"
          }
        }
      ],
      "editor/title": [
        {
          "command": "mindstudio-opsuite.config",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "extension.jsonButtonAction",
          "group": "navigation",
          "when": "editorLangId == json"
        },
        {
          "submenu": "extension/build",
          "group": "navigation",
          "when": "true"
        }
      ],
      "extension/build": [
        {
          "command": "mindstudio-opsuite.buildOps",
          "group": "navigation"
        },
        {
          "command": "mindstudio-opsuite.createOps",
          "group": "navigation"
        }
      ]
    },
    "submenus": [
      {
        "id": "extension/build",
        "label": "buildOps",
        "icon": "resources/build.svg"
      },
      {
        "id": "extension/opsRun",
        "label": "opsRun",
        "icon": "resources/run.svg"
      },
      {
        "id": "extension/opsDebug",
        "label": "opsDebug",
        "icon": "resources/debug.svg"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p . & npm run copy-web-output",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "lint": "eslint plugin/src --ext ts",
    "check-types": "tsc --noEmit",
    "copy-web-output": "tsx ./scripts/copy-web-output.ts"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "node-ssh": "^13.2.1",
    "archiver": "^7.0.1",
    "@types/archiver": "^7.0.0",
    "@types/ssh2": "^1.15.5",
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@rolldown/pluginutils": "^1.0.0-beta.53",
    "@types/vscode": "^1.60.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "eslint": "^8.20.0",
    "typescript": "^4.7.4",
    "vite": "^4.0.0",
    "rollup-plugin-copy": "^3.5.0"
  }
}
