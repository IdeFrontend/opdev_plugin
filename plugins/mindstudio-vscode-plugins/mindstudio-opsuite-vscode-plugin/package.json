{
  "name": "mindstudio-opsuite-vscode-plugins",
  "displayName": "MindStudio Opsuite",
  "description": "A comprehensive operations suite for MindStudio",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mindstudio-opsuite.open",
        "title": "Open MindStudio Opsuite",
        "category": "MindStudio"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vite build",
    "lint": "eslint plugin/src --ext ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "eslint": "^8.20.0",
    "typescript": "^4.7.4",
    "vite": "^4.0.0",
    "ssh2":"^1.17.0",
    "node-ssh":"^13.2.1"
  }
}