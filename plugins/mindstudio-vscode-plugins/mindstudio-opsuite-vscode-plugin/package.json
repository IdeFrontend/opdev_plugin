{
  "name": "huawei-op-devtools-vscode-plugin",
  "displayName": "Huawei OP DevTools",
  "description": "A comprehensive operations suite for MindStudio",
  "publisher": "huawei",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/Asscend/mstt"
  },
  "version": "1.0.115",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "ms-vscode-remote.remote-ssh"
  ],
  "activationEvents": [
    "onView:pluginSidebar",
    "workspaceContains:package.json",
    "onStartupFinished"
  ],
  "icon": "resources/display.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindstudio-opssuite-vscode-plugin",
          "title": "算子一站式交付平台",
          "icon": "resources/homeIcon.svg"
        }
      ]
    },
    "views": {
      "mindstudio-opssuite-vscode-plugin": [
        {
          "id": "pluginSidebar",
          "name": "功能列表",
          "type": "webview"
        }
      ],
      "explorer": [
        {
          "id": "customSidebarView",
          "name": "操作面板",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "huawei-op-devtools.open",
        "title": "新建算子工程"
      },
      {
        "command": "huawei-op-devtools.buildOps",
        "title": "编译算子"
      },
      {
        "command": "huawei-op-devtools.config",
        "title": "配置"
      },
      {
        "command": "huawei-op-devtools.leftNaV",
        "title": "左侧菜单配置"
      },
      {
        "command": "huawei-op-devtools.createOps",
        "title": "新建算子原型文件",
        "icon": "resources/ops.svg"
      },
      {
        "command": "extension.jsonButtonAction",
        "title": "生成算子工程",
        "category": "JSON Tools"
      },
      {
        "command": "csv-viewer.openCsv",
        "title": "打开 CSV 文件",
        "category": "CSV Viewer"
      },
      {
        "command": "huawei-op-devtools.test",
        "title": "测试数据查看器"
      }
    ],
    "menus": {
      "view/title": [

      ]
    },
    "submenus": [
      {
        "id": "extension/build",
        "label": "buildOps",
        "icon": "resources/build.svg"
      },
      {
        "id": "extension/opsRun",
        "label": "opsRun",
        "icon": "resources/run.svg"
      },
      {
        "id": "extension/opsDebug",
        "label": "opsDebug",
        "icon": "resources/debug.svg"
      }
    ],
    "customEditors": [
      {
        "viewType": "csvViewer",
        "displayName": "CSV 表格视图",
        "selector": [
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:web && npm run compile",
    "compile": "npm run compile:web && npm run build-extension && npm run copy-web-output",
    "install:web": "cd web && npm install",
    "compile:web": "npm run install:web && cd web && npm run build",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies",
    "lint": "eslint plugin/src --ext ts",
    "check-types": "tsc --noEmit",
    "build-extension": "tsx ./scripts/build-extension",
    "copy-web-output": "tsx ./scripts/copy-web-output.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "fs-extra": "^11.3.2",
    "i18next": "^25.7.2",
    "node-ssh": "^13.2.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@rolldown/pluginutils": "^1.0.0-beta.53",
    "@types/archiver": "^7.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "16.x",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.1",
    "eslint": "^8.20.0",
    "rollup-plugin-copy": "^3.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
