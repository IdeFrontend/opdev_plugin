{
  "compilerOptions": {
    "module": "node16",
    "types": ["node"],
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "rootDirs": ["plugin/src", "./"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "plugin:/*": ["plugin/src/*"],
      "shared:/*": ["shared/*"]
    }
  },
  "include": ["plugin/src/**/*", "shared/**/*"],
  "exclude": ["node_modules", ".vscode-test", "web", "server"]
}
