{
  "compilerOptions": {
    "module": "node16",
    "types":["node"],
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020","DOM"
    ],
    "sourceMap": true,
    "rootDirs": ["plugin/src","./"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true
  },
  "include": [
    "plugin/src/**/*"
, "server/static_server.js"  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "web",
    "server"
  ]
}