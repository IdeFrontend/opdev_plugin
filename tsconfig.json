{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "rootDirs": ["plugin/src", "plugin/src-v2", "shared"],
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@plugin/*": ["plugin/src/*"],
      "@plugin-v2/*": ["plugin/src-v2/*"]
    }
  },
  "include": ["plugin/src/**/*", "plugin/src-v2/**/*", "shared/**/*"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    ".vscode-test-web",
    ".idea",
    "dist",
    "out",
    "**/*.vsix",
    "web",
    "**/__tests__/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "jest.config.js"
  ]
}
