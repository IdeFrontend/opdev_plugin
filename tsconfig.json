{
  "compilerOptions": {
    "module": "node16",
    "types": ["node"],
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "rootDirs": ["plugin/src", "shared"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "plugin:/*": ["plugin/src/*"],
      "shared:/*": ["shared/*"]
    }
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    ".vscode-test-web",
    ".idea",
    "dist",
    "out",
    "**/*.vsix",
    "deletePackage.js",
    "package.js",
    "web"
  ]
}
