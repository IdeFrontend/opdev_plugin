{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "rootDirs": ["plugin/src", "shared"],
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@plugin/*": ["plugin/src/*"]
    }
  },
  "include": ["plugin/src/**/*", "shared/**/*"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    ".vscode-test-web",
    ".idea",
    "dist",
    "out",
    "**/*.vsix",
    "web"
  ]
}
