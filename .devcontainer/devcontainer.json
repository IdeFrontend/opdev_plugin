{
  "name": "CANN Python 3.12 (mstt)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "platform": "linux/arm64"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=${localWorkspaceFolder}/..,target=/workspace-parent,type=bind"
  ],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
