{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/extension.js"
      ],
      "preLaunchTask": "npm: compile:debug"
    },
    {
      "name": "Debug VS Code Extension (Hot Mode)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/extension.js"
      ],
      "env": {
        "MSTT_DEV_SERVER_URL": "http://localhost:5173"
      },
      "preLaunchTask": "npm: watch"
    },
    {
      "name": "Debug Ascend C Toolkits Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/extension.js"
      ],
      "preLaunchTask": "compile:ascend-c-toolkit:debug"
    },
    {
      "name": "Debug Ascend C Toolkits Extension (Hot Mode)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/extension.js"
      ],
      "env": {
        "MSTT_DEV_SERVER_URL": "http://localhost:5173"
      },
      "preLaunchTask": "ascend-c-toolkit: prewatch"
    },
    {
      "command": "npm run start-web",
      "name": "Debug VS Code Web Extension",
      "request": "launch",
      "type": "node-terminal",
      "preLaunchTask": "npm: compile:debug"
    }
  ]
}
