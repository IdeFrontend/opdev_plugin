{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试vscode扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/extension.js"
      ],
      "preLaunchTask": "npm: compile:debug"
    },
    {
      "command": "npm run start-web",
      "name": "调试vscode web扩展",
      "request": "launch",
      "type": "node-terminal",
      "preLaunchTask": "npm: compile:debug"
    }
  ]
}