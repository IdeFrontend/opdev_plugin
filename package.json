    "viewsWelcome": [
      {
        "view": "opdevtoolsHomeTree",
        "contents": "Click [Help Guide](command:huawei-op-devtools.sidebar.openHelp) or [Welcome Home](command:huawei-op-devtools.sidebar.openWelcome) to view plugin introduction."
      },
      {
        "view": "opdevtoolsHomeTree",
        "contents": "[New Operator Project](command:huawei-op-devtools.open)"
      },
      {
        "view": "opdevtoolsHomeTree",
        "contents": "[Open Operator Project](command:huawei-op-devtools.openProject)"
      }
    ],
    "submenus": [
      {
        "id": "operator.debug",
        "label": "%submenu.operator.debug.label%"
      },
      {
        "id": "operator.performance",
        "label": "%submenu.operator.performance.label%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "huawei-op-devtools.toggleOpsOperate",
          "when": "hasDevtoolConfig"
        }
      ],
      "menuBar/file/new": [
        {
          "command": "huawei-op-devtools.open",
          "title": "%menu.file.new.open.title%"
        }
      ],
      "view/title": [
        {
          "command": "huawei-op-devtools.sidebar.stopAllOperatorActions",
          "when": "view == opdevtoolsOperateTree && opDevtools.operatorActionQueueStopAllVisible",
          "group": "navigation@0"
        },
        {
          "command": "huawei-op-devtools.open",
          "when": "view == opdevtoolsOperateTree",
          "group": "navigation@1"
        },
        {
          "command": "huawei-op-devtools.sidebar.projectConfig",
          "when": "view == opdevtoolsOperateTree",
          "group": "navigation@2"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.report.add",
          "when": "view == opdevtoolsSanitizerResultsTree",
          "group": "navigation@1"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.report.sortTime",
          "when": "view == opdevtoolsSanitizerResultsTree",
          "group": "navigation@2"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.hideDuplicates",
          "when": "view == opdevtoolsSanitizerResultsTree && !opDevtools.sanitizerDuplicatesHidden",
          "group": "navigation@3"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.showDuplicates",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerDuplicatesHidden",
          "group": "navigation@3"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.report.filterMarked",
          "when": "view == opdevtoolsSanitizerResultsTree && !opDevtools.sanitizerMarkedOnly",
          "group": "navigation@4"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.report.showAll",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerMarkedOnly",
          "group": "navigation@4"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.groupByClass",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerResultsGroupBy != 'class'",
          "group": "navigation@5"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.groupByClassActive",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerResultsGroupBy == 'class'",
          "group": "navigation@5"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.groupByType",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerResultsGroupBy != 'type'",
          "group": "navigation@6"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.groupByTypeActive",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerResultsGroupBy == 'type'",
          "group": "navigation@6"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.groupBySeverity",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerResultsGroupBy != 'severity'",
          "group": "navigation@7"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.groupBySeverityActive",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerResultsGroupBy == 'severity'",
          "group": "navigation@7"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.groupByFile",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerResultsGroupBy != 'file'",
          "group": "navigation@8"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.groupByFileActive",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerResultsGroupBy == 'file'",
          "group": "navigation@8"
        },
        {
          "command": "huawei-op-devtools.sidebar.selectAllOperators",
          "when": "view == opdevtoolsOperatorProjectsTree && opDevtools.showOperatorSearch && !opDevtools.allOperatorsSelected",
          "group": "navigation@3"
        },
        {
          "command": "huawei-op-devtools.sidebar.clearSelectedOperators",
          "when": "view == opdevtoolsOperatorProjectsTree && opDevtools.showOperatorSearch && opDevtools.allOperatorsSelected",
          "group": "navigation@4"
        },
        {
          "command": "huawei-op-devtools.sidebar.clearOperatorProjectsSearch",
          "when": "view == opdevtoolsOperatorProjectsTree && opDevtools.showOperatorSearch && opDevtools.operatorProjectsSearchActive",
          "group": "navigation@5"
        },
        {
          "command": "huawei-op-devtools.sidebar.searchOperators",
          "when": "view == opdevtoolsOperatorProjectsTree && opDevtools.showOperatorSearch",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "huawei-op-devtools.sidebar.clearSelectedOperators",
          "when": "view == opdevtoolsOperatorProjectsTree && viewItem =~ /operator-projects-selected/",
          "group": "inline@1"
        },
        {
          "command": "huawei-op-devtools.sidebar.stopFlowTask",
          "when": "view == opdevtoolsOperateTree && viewItem =~ /opdevtools\\.flowRunning/",
          "group": "inline@1"
        },
        {
          "command": "huawei-op-devtools.operate.debugSettings",
          "when": "view == opdevtoolsOperateTree && viewItem =~ /opdevtools\\.debug/",
          "group": "inline@2"
        },
        {
          "command": "huawei-op-devtools.operate.sanitizerSettings",
          "when": "view == opdevtoolsOperateTree && viewItem =~ /opdevtools\\.sanitizer/",
          "group": "inline@2"
        },
        {
          "command": "huawei-op-devtools.operate.onBoardSettings",
          "when": "view == opdevtoolsOperateTree && viewItem =~ /opdevtools\\.onboard/",
          "group": "inline@2"
        },
        {
          "command": "huawei-op-devtools.operate.simulationSettings",
          "when": "view == opdevtoolsOperateTree && viewItem =~ /opdevtools\\.simulation/",
          "group": "inline@2"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.report.copyPath",
          "when": "view == opdevtoolsSanitizerResultsTree && viewItem =~ /opdevtools\\.sanitizerReportItem/",
          "group": "inline@3"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.report.unmark",
          "when": "view == opdevtoolsSanitizerResultsTree && viewItem =~ /opdevtools\\.sanitizerReportItem\\.marked/",
          "group": "inline@4"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.report.mark",
          "when": "view == opdevtoolsSanitizerResultsTree && viewItem =~ /opdevtools\\.sanitizerReportItem\\.unmarked/",
          "group": "inline@4"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.results.openGroupFile",
          "when": "view == opdevtoolsSanitizerResultsTree && viewItem =~ /opdevtools\\.sanitizerPathGroupItem/",
          "group": "inline@1"
        },
        {
          "command": "huawei-op-devtools.sidebar.sanitizer.message.aiFix",
          "when": "view == opdevtoolsSanitizerResultsTree && opDevtools.sanitizerAiFixAvailable && viewItem =~ /opdevtools\\.sanitizerMessage\\.aiFix/",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "huawei-op-devtools.toggleOpsOperate",
          "group": "navigation",
          "when": "hasDevtoolConfig"
        },
        {
          "command": "huawei-op-devtools.sidebar.actionsQuickPick",
          "group": "navigation@1",
          "when": "hasDevtoolConfig"
        }
      ],
      "explorer/context": [
        {
          "command": "huawei-op-devtools.createOperatorInWorkspace",
          "when": "explorerViewletVisible && resourceScheme == 'file'",
          "group": "navigation@1"
        },
        {
          "command": "huawei-op-devtools.markAsOperatorProject",
          "when": "explorerResourceIsFolder",
          "group": "operator@1"
        },
        {
          "command": "huawei-op-devtools.markAsMultiOperatorProject",
          "when": "explorerResourceIsFolder",
          "group": "operator@1"
        },
        {
          "command": "huawei-op-devtools.unmarkAsOperatorProject",
          "when": "explorerResourceIsFolder",
          "group": "operator@2"
        },
        {
          "command": "huawei-op-devtools.unmarkAsMultiOperatorProject",
          "when": "explorerResourceIsFolder",
          "group": "operator@2"
        },
        {
          "command": "huawei-op-devtools.operatorProjectBuild",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.1"
        },
        {
          "command": "huawei-op-devtools.operatorProjectRun",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.2"
        },
        {
          "submenu": "operator.debug",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.3"
        },
        {
          "command": "huawei-op-devtools.operatorProjectSanitizer",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.4"
        },
        {
          "submenu": "operator.performance",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.5"
        },
        {
          "command": "huawei-op-devtools.reportVisualizationSanitizer",
          "when": "resourceScheme == 'file' && resourceExtname == '.log'",
          "group": "operator@3.6"
        },
        {
          "command": "huawei-op-devtools.reportVisualizationPerformance",
          "when": "explorerResourceIsFolder",
          "group": "operator@3.6"
        },
        {
          "command": "huawei-op-devtools.importDumpTensorBinFile",
          "when": "resourceScheme == 'file' && resourceExtname == '.bin'",
          "group": "operator@3.7"
        }
      ],
      "operator.debug": [
        {
          "command": "huawei-op-devtools.operatorProjectCpuDebug"
        },
        {
          "command": "huawei-op-devtools.operatorProjectCpuDebugConfig"
        }
      ],
      "operator.performance": [
        {
          "command": "huawei-op-devtools.operatorProjectOnBoard"
        },
        {
          "command": "huawei-op-devtools.operatorProjectSimulation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "csvViewer",
        "displayName": "%customEditor.csvViewer.displayName%",
        "selector": [
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "package": "pnpm run compile && vsce package --no-dependencies --allow-package-secrets privatekey --baseContentUrl https://gitcode.com/kaocong/mstt/raw/main/ --baseImagesUrl https://gitcode.com/kaocong/mstt/raw/main/",
    "build": "pnpm run compile",
    "build:icons-font": "node scripts/build-icons-font.mjs",
    "compile": "pnpm run compile:web && pnpm run compile:plugin",
    "compile:web": "cd web && pnpm run build",
    "compile:plugin": "tsc --noEmit && tsx scripts/build-extension",
    "package:debug": "pnpm run compile:debug && vsce package --no-dependencies --allow-package-secrets privatekey --baseContentUrl https://gitcode.com/kaocong/mstt/raw/main/ --baseImagesUrl https://gitcode.com/kaocong/mstt/raw/main/",
    "compile:debug": "pnpm run compile:web:debug && pnpm run compile:plugin:debug",
    "compile:web:debug": "cd web && pnpm run build:debug",
    "compile:plugin:debug": "tsx scripts/build-extension --sourcemap",
    "package:readable": "pnpm run compile:readable && vsce package --no-dependencies --allow-package-secrets privatekey --baseContentUrl https://gitcode.com/kaocong/mstt/raw/main/ --baseImagesUrl https://gitcode.com/kaocong/mstt/raw/main/",
    "compile:readable": "pnpm run compile:web:readable && pnpm run compile:plugin:readable",
    "compile:web:readable": "cd web && pnpm run build --mode=readable",
    "compile:plugin:readable": "tsx scripts/build-extension --sourcemap --readable",
    "watch": "tsx scripts/build-extension --watch --sourcemap",
    "lint": "oxlint . && eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit && cd web && vue-tsc --noEmit",
    "install:web": "cd web && pnpm install",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "oxlint",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@mstt/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.9",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.6.0",
    "@types/vscode": "^1.60.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.77",
    "@vscode/vsce": "^3.7.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "^1.36.0",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.36.0",
    "postcss": "^8.5.6",
    "svgtofont": "^6.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.2.1"
  }
}