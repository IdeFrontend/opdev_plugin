{
  "name": "huawei-op-devtools-vscode-plugin",
  "displayName": "Huawei OP DevTools",
  "description": "Operator development, debugging, and performance analysis all-in-one platform for Ascend C language.",
  "publisher": "huawei",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/kaocong/mstt"
  },
  "version": "1.2.7",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension.js",
  "activationEvents": [
    "onView:pluginSidebar",
    "workspaceContains:package.json",
    "onStartupFinished"
  ],
  "icon": "web/resources/extension_icon.png",
  "contributes": {
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "op-devtools.debugMode": {
          "type": "boolean",
          "default": true,
          "description": "%config.op-devtools.debugMode.description%"
        }
      }
    },
    "colors": [
      {
        "id": "huawei-op-devtools.operatorProject",
        "description": "%colors.operatorProject.description%",
        "defaults": {
          "dark": "#5CB3FF",
          "light": "#1890FF"
        }
      },
      {
        "id": "huawei-op-devtools.operatorProjectCollection",
        "description": "%colors.operatorProjectCollection.description%",
        "defaults": {
          "dark": "#B37FEB",
          "light": "#722ED1"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindstudio-opssuite-vscode-plugin",
          "title": "%viewContainer.activitybar.title%",
          "icon": "web/resources/activitybar_logo_mono.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "huawei-op-devtools-secondary-sidebar",
          "title": "%viewContainer.secondarySidebar.title%",
          "icon": "web/resources/operate_icon_mono.svg"
        }
      ],
      "secondaryActivitybar": [
        {
          "id": "huawei-op-devtools-secondary-sidebar",
          "title": "%viewContainer.secondaryActivitybar.title%",
          "icon": "web/resources/operate_icon_mono.svg"
        }
      ],
      "panel": [
        {
          "id": "ms-sanitizer-panel-view",
          "title": "%viewContainer.panel.sanitizer.title%",
          "icon": "web/resources/ops_icon_mono.svg"
        },
        {
          "id": "performance-panel-view",
          "title": "%viewContainer.panel.performance.title%",
          "icon": "web/resources/power.svg"
        },
        {
          "id": "dump-tensor-panel-view",
          "title": "DumpTensor数据",
          "icon": "web/resources/tensor.svg"
        }
      ]
    },
    "views": {
      "mindstudio-opssuite-vscode-plugin": [
        {
          "id": "pluginSidebar",
          "name": "%view.pluginSidebar.name%",
          "type": "webview"
        }
      ],
      "huawei-op-devtools-secondary-sidebar": [
        {
          "type": "webview",
          "id": "OpsOperateProvider",
          "name": "%view.opsOperate.name%"
        }
      ],
      "ms-sanitizer-panel-view": [
        {
          "type": "webview",
          "id": "msSanitizerPanelView",
          "name": "%view.msSanitizer.name%",
          "when": "true"
        }
      ],
      "performance-panel-view": [
        {
          "type": "webview",
          "id": "performancePanelView",
          "name": "%view.performance.name%",
          "when": "true"
        }
      ],
      "dump-tensor-panel-view": [
        {
          "type": "webview",
          "id": "dumpTensorPanelView",
          "name": "DumpTensor数据",
          "when": "true"
        }
      ],
      "explorer": []
    },
    "commands": [
      {
        "command": "huawei-op-devtools.open",
        "title": "%command.open.title%"
      },
      {
        "command": "huawei-op-devtools.openProject",
        "title": "%command.openProject.title%"
      },
      {
        "command": "huawei-op-devtools.buildOps",
        "title": "%command.buildOps.title%"
      },
      {
        "command": "huawei-op-devtools.toggleOpsOperate",
        "title": "%command.toggleOpsOperate.title%",
        "category": "%command.toggleOpsOperate.category%",
        "icon": "web/resources/operate.svg"
      },
      {
        "command": "huawei-op-devtools.config",
        "title": "%command.config.title%"
      },
      {
        "command": "huawei-op-devtools.leftNaV",
        "title": "%command.leftNav.title%"
      },
      {
        "command": "huawei-op-devtools.createOps",
        "title": "%command.createOps.title%",
        "icon": "web/resources/ops_icon_mono.svg"
      },
      {
        "command": "extension.jsonButtonAction",
        "title": "%command.jsonButtonAction.title%",
        "category": "%command.jsonButtonAction.category%"
      },
      {
        "command": "csv-viewer.openCsv",
        "title": "%command.openCsv.title%",
        "category": "%command.openCsv.category%"
      },
      {
        "command": "huawei-op-devtools.test",
        "title": "%command.test.title%"
      },
      {
        "command": "huawei-op-devtools.projectSH",
        "title": "%command.projectSH.title%"
      },
      {
        "command": "huawei-op-devtools.welcome",
        "title": "%command.welcome.title%"
      },
      {
        "command": "huawei-op-devtools.clearWelcomeCount",
        "title": "%command.clearWelcomeCount.title%"
      },
      {
        "command": "huawei-op-devtools.open-ms-sanitizer-panel-view",
        "title": "%command.openMsSanitizer.title%"
      },
      {
        "command": "huawei-op-devtools.open-performance-panel-view",
        "title": "%command.openPerformance.title%"
      },
      {
        "command": "huawei-op-devtools.open-dump-tensor-panel-view",
        "title": "DumpTensor数据"
      },
      {
        "command": "vscodeJumpToFile",
        "title": "%command.vscodeJumpToFile.title%"
      },
      {
        "command": "huawei-op-devtools.flashMsSanitizerRunData",
        "title": "%command.flashMsSanitizer.title%"
      },
      {
        "command": "huawei-op-devtools.flashPerformanceRunData",
        "title": "%command.flashPerformance.title%"
      },
      {
        "command": "huawei-op-devtools.createOperatorInWorkspace",
        "title": "%command.createOperatorInWorkspace.title%"
      },
      {
        "command": "huawei-op-devtools.clearLastProjectPath",
        "title": "%command.clearLastProjectPath.title%"
      },
      {
        "command": "huawei-op-devtools.simulatorOptions",
        "title": "%command.simulatorOptions.title%"
      },
      {
        "command": "huawei-op-devtools.onBoardOptions",
        "title": "%command.onBoardOptions.title%"
      },
      {
        "command": "huawei-op-devtools.sanitizerOptions",
        "title": "%command.sanitizerOptions.title%"
      },
      {
        "command": "huawei-op-devtools.markAsOperatorProject",
        "title": "%command.markAsOperatorProject.title%"
      },
      {
        "command": "huawei-op-devtools.markAsMultiOperatorProject",
        "title": "%command.markAsMultiOperatorProject.title%"
      },
      {
        "command": "huawei-op-devtools.unmarkAsOperatorProject",
        "title": "%command.unmarkAsOperatorProject.title%"
      },
      {
        "command": "huawei-op-devtools.unmarkAsMultiOperatorProject",
        "title": "%command.unmarkAsMultiOperatorProject.title%"
      },
      {
        "command": "huawei-op-devtools.operatorProjectBuild",
        "title": "%command.operatorProjectBuild.title%"
      },
      {
        "command": "huawei-op-devtools.operatorProjectRun",
        "title": "%command.operatorProjectRun.title%"
      },
      {
        "command": "huawei-op-devtools.operatorProjectCpuDebug",
        "title": "%command.operatorProjectCpuDebug.title%"
      },
      {
        "command": "huawei-op-devtools.operatorProjectCpuDebugConfig",
        "title": "%command.operatorProjectCpuDebugConfig.title%"
      },
      {
        "command": "huawei-op-devtools.operatorProjectSanitizer",
        "title": "%command.operatorProjectSanitizer.title%"
      },
      {
        "command": "huawei-op-devtools.operatorProjectOnBoard",
        "title": "%command.operatorProjectOnBoard.title%"
      },
      {
        "command": "huawei-op-devtools.operatorProjectSimulation",
        "title": "%command.operatorProjectSimulation.title%"
      },
      {
        "command": "huawei-op-devtools.reportVisualizationSanitizer",
        "title": "%command.reportVisualizationSanitizer.title%"
      },
      {
        "command": "huawei-op-devtools.reportVisualizationOnBoard",
        "title": "%command.reportVisualizationOnBoard.title%"
      },
      {
        "command": "huawei-op-devtools.reportVisualizationSimulation",
        "title": "%command.reportVisualizationSimulation.title%"
      },
      {
        "command": "huawei-op-devtools.reportVisualizationPerformance",
        "title": "%command.reportVisualizationPerformance.title%"
      },
      {
        "command": "huawei-op-devtools.refreshFolderDecorations",
        "title": "%command.refreshFolderDecorations.title%"
      },
      {
        "command": "huawei-op-devtools.importDumpTensorBinFile",
        "title": "%command.importDumpTensorBinFile.title%"
      }
    ],
    "submenus": [
      {
        "id": "operator.debug",
        "label": "%submenu.operator.debug.label%"
      },
      {
        "id": "operator.performance",
        "label": "%submenu.operator.performance.label%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "huawei-op-devtools.toggleOpsOperate",
          "when": "hasDevtoolConfig"
        }
      ],
      "menuBar/file/new": [
        {
          "command": "huawei-op-devtools.open",
          "title": "%menu.file.new.open.title%"
        }
      ],
      "view/title": [],
      "editor/title": [
        {
          "command": "huawei-op-devtools.toggleOpsOperate",
          "group": "navigation",
          "when": "hasDevtoolConfig"
        }
      ],
      "explorer/context": [
        {
          "command": "huawei-op-devtools.createOperatorInWorkspace",
          "when": "explorerViewletVisible && resourceScheme == 'file'",
          "group": "navigation@1"
        },
        {
          "command": "huawei-op-devtools.markAsOperatorProject",
          "when": "explorerResourceIsFolder",
          "group": "operator@1"
        },
        {
          "command": "huawei-op-devtools.markAsMultiOperatorProject",
          "when": "explorerResourceIsFolder",
          "group": "operator@1"
        },
        {
          "command": "huawei-op-devtools.unmarkAsOperatorProject",
          "when": "explorerResourceIsFolder",
          "group": "operator@2"
        },
        {
          "command": "huawei-op-devtools.unmarkAsMultiOperatorProject",
          "when": "explorerResourceIsFolder",
          "group": "operator@2"
        },
        {
          "command": "huawei-op-devtools.operatorProjectBuild",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.1"
        },
        {
          "command": "huawei-op-devtools.operatorProjectRun",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.2"
        },
        {
          "submenu": "operator.debug",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.3"
        },
        {
          "command": "huawei-op-devtools.operatorProjectSanitizer",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.4"
        },
        {
          "submenu": "operator.performance",
          "when": "explorerResourceIsFolder || resourceExtname == '.py'",
          "group": "operator@3.5"
        },
        {
          "command": "huawei-op-devtools.reportVisualizationSanitizer",
          "when": "resourceScheme == 'file' && resourceExtname == '.log'",
          "group": "operator@3.6"
        },
        {
          "command": "huawei-op-devtools.reportVisualizationPerformance",
          "when": "explorerResourceIsFolder",
          "group": "operator@3.6"
        },
        {
          "command": "huawei-op-devtools.importDumpTensorBinFile",
          "when": "resourceScheme == 'file' && resourceExtname == '.bin'",
          "group": "operator@3.7"
        }
      ],
      "operator.debug": [
        {
          "command": "huawei-op-devtools.operatorProjectCpuDebug"
        },
        {
          "command": "huawei-op-devtools.operatorProjectCpuDebugConfig"
        }
      ],
      "operator.performance": [
        {
          "command": "huawei-op-devtools.operatorProjectOnBoard"
        },
        {
          "command": "huawei-op-devtools.operatorProjectSimulation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "csvViewer",
        "displayName": "%customEditor.csvViewer.displayName%",
        "selector": [
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "package": "pnpm run compile && vsce package --no-dependencies",
    "build": "pnpm run compile",
    "compile": "pnpm run compile:web && pnpm run compile:plugin",
    "compile:web": "cd web && pnpm run build",
    "compile:plugin": "tsc --noEmit && tsx scripts/build-extension",
    "package:debug": "pnpm run compile:debug && vsce package --no-dependencies",
    "compile:debug": "pnpm run compile:web:debug && pnpm run compile:plugin:debug",
    "compile:web:debug": "cd web && pnpm run build:debug",
    "compile:plugin:debug": "tsx scripts/build-extension --sourcemap",
    "package:readable": "pnpm run compile:readable && vsce package --no-dependencies",
    "compile:readable": "pnpm run compile:web:readable && pnpm run compile:plugin:readable",
    "compile:web:readable": "cd web && pnpm run build --mode=readable",
    "compile:plugin:readable": "tsx scripts/build-extension --sourcemap --readable",
    "watch": "tsx scripts/build-extension --watch --sourcemap",
    "lint": "oxlint . && eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit && cd web && vue-tsc --noEmit",
    "install:web": "cd web && pnpm install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "oxlint",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@mstt/shared": "workspace:*"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.9",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.6.0",
    "@types/vscode": "^1.60.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vscode/test-web": "^0.0.77",
    "@vscode/vsce": "^3.7.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "^1.36.0",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.36.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.2.1"
  }
}