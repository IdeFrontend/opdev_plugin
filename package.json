{
  "name": "huawei-op-devtools-vscode-plugin",
  "displayName": "Huawei OP DevTools",
  "description": "Operator development, debugging, and performance analysis all-in-one platform for Ascend C language.",
  "publisher": "huawei",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/kaocong/mstt"
  },
  "version": "1.2.9",
  "engines": {
    "node": ">=16.0.0",
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension.js",
  "activationEvents": [
    "onView:opdevtoolsHomeTree",
    "workspaceContains:package.json",
    "onStartupFinished"
  ],
  "icon": "web/resources/extension_icon.png",
  "contributes": {
    "icons": {
      "opdevtools-beaker": {
        "description": "Beaker icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea01"
        }
      },
      "opdevtools-build": {
        "description": "Build icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea02"
        }
      },
      "opdevtools-check": {
        "description": "Check icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea03"
        }
      },
      "opdevtools-debug-cpu": {
        "description": "CPU debug icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea04"
        }
      },
      "opdevtools-debug-npu": {
        "description": "NPU debug icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea05"
        }
      },
      "opdevtools-debug": {
        "description": "Debug icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea06"
        }
      },
      "opdevtools-flag-filled": {
        "description": "Filled flag icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea07"
        }
      },
      "opdevtools-flag-outlined": {
        "description": "Outlined flag icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea08"
        }
      },
      "opdevtools-group-class": {
        "description": "Group by class icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea0a"
        }
      },
      "opdevtools-group-class-pressed": {
        "description": "Group by class pressed icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea09"
        }
      },
      "opdevtools-group-file": {
        "description": "Group by file icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea0c"
        }
      },
      "opdevtools-group-file-pressed": {
        "description": "Group by file pressed icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea0b"
        }
      },
      "opdevtools-group-severity-error": {
        "description": "Error severity icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea0e"
        }
      },
      "opdevtools-group-severity-error-pressed": {
        "description": "Error severity pressed icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea0d"
        }
      },
      "opdevtools-group-severity-warning": {
        "description": "Warning severity icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea10"
        }
      },
      "opdevtools-group-severity-warning-pressed": {
        "description": "Warning severity pressed icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea0f"
        }
      },
      "opdevtools-group-type": {
        "description": "Group by type icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea12"
        }
      },
      "opdevtools-group-type-pressed": {
        "description": "Group by type pressed icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea11"
        }
      },
      "opdevtools-onboard": {
        "description": "Onboard icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea13"
        }
      },
      "opdevtools-power": {
        "description": "Power icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea14"
        }
      },
      "opdevtools-run": {
        "description": "Run icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea15"
        }
      },
      "opdevtools-simulation": {
        "description": "Simulation icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea18"
        }
      },
      "opdevtools-tensor": {
        "description": "Tensor icon",
        "default": {
          "fontPath": "./web/src/assets/fonts/opdevtools-icons.woff",
          "fontCharacter": "\\ea19"
        }
      }
    },
    "configuration": [
      {
        "id": "op-devtools.compileAndDeploy",
        "title": "%config.category.compileAndDeploy.title%",
        "type": "object",
        "properties": {
          "op-devtools": {
            "type": "object",
            "default": {}
          },
          "op-devtools.debugMode": {
            "type": "boolean",
            "default": true,
            "description": "%config.op-devtools.debugMode.description%"
          },
          "op-devtools.compileAndDeploy.buildConfig.operatorNameToCompile": {
            "type": "string",
            "order": 100
          },
          "op-devtools.compileAndDeploy.buildConfig.deployCommandOrRunCommand": {
            "type": "string",
            "order": 101
          },
          "op-devtools.compileAndDeploy.buildConfig.compileCommand": {
            "type": "string",
            "order": 102
          },
          "op-devtools.compileAndDeploy.buildConfig.utTestCompileCommand": {
            "type": "string",
            "order": 103
          },
          "op-devtools.compileAndDeploy.buildConfig.npuDebugCompileCommand": {
            "type": "string",
            "order": 104
          },
          "op-devtools.compileAndDeploy.buildConfig.cpuDebugCompileCommand": {
            "type": "string",
            "order": 105
          },
          "op-devtools.compileAndDeploy.buildConfig.sanitizerCompileCommand": {
            "type": "string",
            "order": 106
          },
          "op-devtools.compileAndDeploy.buildConfig.onBoardCompileCommand": {
            "type": "string",
            "order": 107
          },
          "op-devtools.compileAndDeploy.buildConfig.simulationCompileCommand": {
            "type": "string",
            "order": 108
          },
          "op-devtools.compileAndDeploy.exampleBuildConfig.executionMode": {
            "type": "string",
            "order": 109,
            "enum": [
              "eager",
              "graph"
            ]
          },
          "op-devtools.compileAndDeploy.exampleBuildConfig.runCommand": {
            "type": "string",
            "order": 111,
            "markdownDescription": "%config.op-devtools.compileAndDeploy.exampleBuildConfig.runCommand.markdownDescription%"
          }
        }
      },
      {
        "id": "op-devtools.sanitizer",
        "title": "%config.category.sanitizer.title%",
        "type": "object",
        "properties": {
          "op-devtools.sanitizer.showQuickOptions": {
            "type": "boolean",
            "default": true,
            "order": 100,
            "description": "%config.op-devtools.sanitizer.showQuickOptions.description%",
            "markdownDescription": "%config.op-devtools.sanitizer.showQuickOptions.markdownDescription%"
          },
          "op-devtools.sanitizer.memory": {
            "type": "boolean",
            "order": 200,
            "markdownDescription": "%config.op-devtools.sanitizer.memory.markdownDescription%"
          },
          "op-devtools.sanitizer.memoryLeak": {
            "type": "boolean",
            "order": 201,
            "markdownDescription": "%config.op-devtools.sanitizer.memoryLeak.markdownDescription%"
          },
          "op-devtools.sanitizer.allocUnused": {
            "type": "boolean",
            "order": 202,
            "markdownDescription": "%config.op-devtools.sanitizer.allocUnused.markdownDescription%"
          },
          "op-devtools.sanitizer.race": {
            "type": "boolean",
            "order": 203
          },
          "op-devtools.sanitizer.uninitialized": {
            "type": "boolean",
            "order": 204
          },
          "op-devtools.sanitizer.reportLogLevel": {
            "type": "string",
            "order": 205,
            "enum": [
              "info",
              "warn",
              "error"
            ]
          },
          "op-devtools.sanitizer.maxSingleLogFileSize": {
            "type": "number",
            "order": 206,
            "minimum": 1,
            "maximum": 10240,
            "markdownDescription": "%config.op-devtools.sanitizer.maxSingleLogFileSize.markdownDescription%"
          },
          "op-devtools.sanitizer.detectionScope": {
            "type": "string",
            "order": 207,
            "enum": [
              "global",
              "singleBlock"
            ],
            "markdownDescription": "%config.op-devtools.sanitizer.detectionScope.markdownDescription%"
          },
          "op-devtools.sanitizer.blockId": {
            "type": [
              "number",
              "null"
            ],
            "order": 208,
            "minimum": 0,
            "maximum": 200
          },
          "op-devtools.sanitizer.enableMsAgentAiFix": {
            "type": "boolean",
            "default": true,
            "order": 209,
            "description": "%config.op-devtools.sanitizer.enableMsAgentAiFix.description%",
            "markdownDescription": "%config.op-devtools.sanitizer.enableMsAgentAiFix.markdownDescription%"
          }
        }
      },
      {
        "id": "op-devtools.performanceTuning",
        "title": "%config.category.performanceTuning.title%",
        "type": "object",
        "properties": {
          "op-devtools.performanceTuning.simulation.showQuickOptions": {
            "type": "boolean",
            "default": true,
            "order": 298,
            "description": "%config.op-devtools.performanceTuning.simulation.showQuickOptions.description%",
            "markdownDescription": "%config.op-devtools.performanceTuning.simulation.showQuickOptions.markdownDescription%"
          },
          "op-devtools.performanceTuning.simulation.simulatorType": {
            "type": "string",
            "order": 300,
            "markdownDescription": "%config.op-devtools.performanceTuning.simulation.simulatorType.markdownDescription%"
          },
          "op-devtools.performanceTuning.simulation.memoryThroughputWaveform": {
            "type": "boolean",
            "order": 301,
            "markdownDescription": "%config.op-devtools.performanceTuning.simulation.memoryThroughputWaveform.markdownDescription%"
          },
          "op-devtools.performanceTuning.simulation.resourceConflictRatio": {
            "type": "boolean",
            "order": 302,
            "markdownDescription": "%config.op-devtools.performanceTuning.simulation.resourceConflictRatio.markdownDescription%"
          },
          "op-devtools.performanceTuning.simulation.parameters": {
            "type": "object",
            "order": 303,
            "default": {},
            "additionalProperties": {
              "type": "string"
            },
            "markdownDescription": "%config.op-devtools.performanceTuning.simulation.parameters.markdownDescription%"
          },
          "op-devtools.performanceTuning.onBoard.showQuickOptions": {
            "type": "boolean",
            "default": true,
            "order": 309,
            "description": "%config.op-devtools.performanceTuning.onBoard.showQuickOptions.description%",
            "markdownDescription": "%config.op-devtools.performanceTuning.onBoard.showQuickOptions.markdownDescription%"
          },
          "op-devtools.performanceTuning.onBoard.interCoreLoad": {
            "type": "boolean",
            "order": 310
          },
          "op-devtools.performanceTuning.onBoard.roofline": {
            "type": "boolean",
            "order": 311,
            "markdownDescription": "%config.op-devtools.performanceTuning.onBoard.roofline.markdownDescription%"
          },
          "op-devtools.performanceTuning.onBoard.operatorCodeHotspot": {
            "type": "boolean",
            "order": 312
          },
          "op-devtools.performanceTuning.onBoard.cacheHeatmap": {
            "type": "boolean",
            "order": 313,
            "markdownDescription": "%config.op-devtools.performanceTuning.onBoard.cacheHeatmap.markdownDescription%"
          },
          "op-devtools.performanceTuning.onBoard.operatorMetrics": {
            "type": "boolean",
            "order": 314,
            "markdownDescription": "%config.op-devtools.performanceTuning.onBoard.operatorMetrics.markdownDescription%"
          },
          "op-devtools.performanceTuning.onBoard.cubeAndVectorInstructionTimeAndRatio": {
            "type": "boolean",
            "order": 315
          },
          "op-devtools.performanceTuning.onBoard.l2CacheHitRate": {
            "type": "boolean",
            "order": 316
          },
          "op-devtools.performanceTuning.onBoard.memoryReadWriteBandwidth": {
            "type": "boolean",
            "order": 317
          },
          "op-devtools.performanceTuning.onBoard.l0ReadWriteBandwidth": {
            "type": "boolean",
            "order": 318
          },
          "op-devtools.performanceTuning.onBoard.ubReadWriteBandwidth": {
            "type": "boolean",
            "order": 319
          },
          "op-devtools.performanceTuning.onBoard.computeAndMoveUnitTimeRatio": {
            "type": "boolean",
            "order": 320
          },
          "op-devtools.performanceTuning.onBoard.resourceConflictRatio": {
            "type": "boolean",
            "order": 321
          },
          "op-devtools.performanceTuning.onBoard.enableKernelCodeSegmentProfiling": {
            "type": "boolean",
            "order": 322,
            "markdownDescription": "%config.op-devtools.performanceTuning.onBoard.enableKernelCodeSegmentProfiling.markdownDescription%"
          },
          "op-devtools.performanceTuning.onBoard.parameters": {
            "type": "object",
            "order": 323,
            "default": {},
            "additionalProperties": {
              "type": "string"
            },
            "markdownDescription": "%config.op-devtools.performanceTuning.onBoard.parameters.markdownDescription%"
          }
        }
      },
      {
        "id": "op-devtools.environment",
        "title": "%config.category.environment.title%",
        "type": "object",
        "properties": {
          "op-devtools.environment.environmentScript": {
            "type": "string",
            "default": "/etc/profile",
            "order": 400,
            "markdownDescription": "%config.op-devtools.environment.environmentScript.markdownDescription%"
          },
          "op-devtools.environment.socVersion": {
            "type": "string",
            "default": "ascend910b",
            "order": 401,
            "markdownDescription": "%config.op-devtools.environment.socVersion.markdownDescription%"
          }
        }
      },
      {
        "id": "op-devtools.operatorSupport",
        "title": "%config.category.operatorSupport.title%",
        "type": "object",
        "properties": {
          "op-devtools.operatorSupport.triton": {
            "type": "boolean",
            "default": false,
            "order": 500,
            "description": "%config.op-devtools.operatorSupport.triton.description%"
          }
        }
      }
    ],
    "colors": [
      {
        "id": "huawei.op.devtools.operatorProject",
        "description": "%colors.operatorProject.description%",
        "defaults": {
          "dark": "#5CB3FF",
          "light": "#1890FF"
        }
      },
      {
        "id": "huawei.op.devtools.operatorProjectCollection",
        "description": "%colors.operatorProjectCollection.description%",
        "defaults": {
          "dark": "#B37FEB",
          "light": "#722ED1"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindstudio-opssuite-vscode-plugin",
          "title": "%viewContainer.activitybar.title%",
          "icon": "web/resources/activitybar_logo_mono.svg"
        },
        {
          "id": "huawei-op-devtools-secondary-sidebar",
          "title": "%viewContainer.secondarySidebar.title%",
          "icon": "web/resources/operate_icon_mono.svg"
        }
      ],
      "panel": [
        {
          "id": "performance-panel-view",
          "title": "%viewContainer.panel.performance.title%",
          "icon": "web/resources/power.svg"
        },
        {
          "id": "dump-tensor-panel-view",
          "title": "%viewContainer.panel.dumpTensor.title%",
          "icon": "web/resources/tensor.svg"
        }
      ]
    },
    "views": {
      "mindstudio-opssuite-vscode-plugin": [
        {
          "id": "opdevtoolsHomeTree",
          "name": "Home",
          "when": "opDevtools.showHomeTree"
        },
        {
          "id": "opdevtoolsOperatorProjectsTree",
          "name": "%view.operatorProjects.name%",
          "when": "opDevtools.showOperatorProjects"
        },
        {
          "id": "opdevtoolsOperateTree",
          "name": "%view.opsOperate.name%",
          "when": "opDevtools.showOperateTree"
        },
        {
          "id": "opdevtoolsSanitizerResultsTree",
          "name": "%view.sanitizerResultsTree.name%",
          "when": "opDevtools.showOperateTree"
        }
      ],
      "performance-panel-view": [
        {
          "type": "webview",
          "id": "performancePanelView",
          "name": "%view.performance.name%",
          "when": "true"
        }
      ],
      "dump-tensor-panel-view": [
        {
          "type": "webview",
          "id": "dumpTensorPanelView",
          "name": "%view.dumpTensor.name%",
          "when": "true"
        }
      ],
      "explorer": []
    },
